{
  "name": "0xlynk",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start:signaling": "npm --workspace @0xshare/signaling-server run dev",
    "start:signaling:prod": "npm --workspace @0xshare/signaling-server run start",
    "test:smoke": "node scripts/smoke-signaling.cjs",
    "showcase:capture": "node scripts/capture-showcase.mjs",
    "docker:up": "docker compose up --build",
    "docker:up:detached": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "demo:share": "docker compose -f docker-compose.yml -f docker-compose.demo.yml up --build",
    "demo:down": "docker compose -f docker-compose.yml -f docker-compose.demo.yml down"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
